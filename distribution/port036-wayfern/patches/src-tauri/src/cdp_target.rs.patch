+tokio::task_local! {
+  static EXACT_PAGE: Option<(String, String)>;
+}
+
+/// Per-call target, never a global selection shared by parallel agents.
+pub(crate) async fn with_exact_page<F: std::future::Future>(
+  profile: Option<&str>,
+  page: Option<&str>,
+  work: F,
+) -> F::Output {
+  EXACT_PAGE
+    .scope(
+      profile
+        .zip(page)
+        .map(|(p, t)| (p.to_string(), t.to_string())),
+      work,
+    )
+    .await
+}
