+#[cfg(test)]
+mod authorized_transport_tests {
+  use super::*;
+  #[tokio::test]
+  async fn local_and_cloud_sessions_cannot_cross_or_teardown_each_other() {
+    let server = McpServer::new();
+    server.mark_engine_ready_for_tests();
+    let init = br#"{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{},"clientInfo":{"name":"test","version":"1"}}}"#;
+    let local = match server.handle_local_message(None, init).await {
+      McpOutcome::Body {
+        new_session_id: Some(id),
+        ..
+      } => id,
+      _ => panic!("Local initialize refused"),
+    };
+    let cloud = match server.handle_message(None, init).await {
+      McpOutcome::Body {
+        new_session_id: Some(id),
+        ..
+      } => id,
+      _ => panic!("Cloud initialize refused"),
+    };
+    let ping = br#"{"jsonrpc":"2.0","id":2,"method":"ping"}"#;
+    assert!(matches!(
+      server.handle_local_message(Some(&cloud), ping).await,
+      McpOutcome::UnknownSession
+    ));
+    assert!(matches!(
+      server.handle_message(Some(&local), ping).await,
+      McpOutcome::UnknownSession
+    ));
+    let notification = br#"{"jsonrpc":"2.0","method":"notifications/initialized"}"#;
+    assert!(matches!(
+      server
+        .handle_local_message(Some(&cloud), notification)
+        .await,
+      McpOutcome::Accepted
+    ));
+    assert!(
+      !server
+        .inner
+        .lock()
+        .await
+        .sessions
+        .get(&cloud)
+        .unwrap()
+        .initialized
+    );
+    server.end_local_session(&cloud).await;
+    assert!(server.inner.lock().await.sessions.contains_key(&cloud));
+    server.end_local_session(&local).await;
+    assert!(!server.inner.lock().await.sessions.contains_key(&local));
+  }
+  #[test]
+  fn cbrowser155_never_uses_wayfern_private_protocol_domains() {
+    assert_eq!(
+      Engine::for_browser("cloak", "155.0.8059.39.1"),
+      Engine::Fallback
+    );
+    assert_eq!(
+      Engine::for_browser("wayfern", "155.0.8059.39.1"),
+      Engine::Wayfern
+    );
+  }
