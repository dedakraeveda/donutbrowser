+test("authorized CBrowser picker and bulk templates preserve the external engine contract", {
+  skip: !process.env.DONUT_E2E_CBROWSER_PATH,
+}, async () => {
+  await withApp(
+    "ui-cbrowser-create",
+    async (app) => {
+      await openProfileCreation(app);
+      await app.waitFor(
+        () =>
+          app.execute(
+            "return document.querySelector('#profile-engine')?.textContent.includes('CBrowser');",
+          ),
+        { description: "CBrowser capability discovery" },
+      );
+      await app.fillSelector("#profile-name", "CBrowser UI fixture");
+      await app.capture("cbrowser-create-picker");
+      const profile = await submitProfileCreation(app, "CBrowser UI fixture");
+      assert.equal(profile.browser, "cloak");
+      assert.equal(profile.version, "external");
+      const batch = await app.invoke("bulk_create_profiles", {
+        settings: { browser: "cloak" },
+        name: "CBrowser batch",
+        count: 2,
+      });
+      assert.equal(batch.error, null);
+      assert.equal(batch.created.length, 2);
+      assert.ok(
+        batch.created.every(
+          (p) => p.browser === "cloak" && p.version === "external",
+        ),
+      );
+    },
+    { extraEnv: { BROWSER_BINARY_PATH: process.env.DONUT_E2E_CBROWSER_PATH } },
+  );
+});
 
