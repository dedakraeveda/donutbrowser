+test("authorized fork local MCP has an authenticated lifecycle without cloud", async () => {
+  await withApp("local-mcp-contract", async (app) => {
+    const engine = await app.invoke("get_cloak_engine_status");
+    assert.equal(engine.release, "1.33");
+    await assert.rejects(
+      app.invoke("set_cloak_binary_path", {
+        path: "D:/missing-port036-browser.exe",
+      }),
+    );
+    assert.equal(await app.invoke("get_mcp_server_status"), false);
+    const port = await app.invoke("start_mcp_server", { port: 0 });
+    assert.ok(port > 0);
+    const config = await app.invoke("get_mcp_config");
+    assert.equal(config.port, port);
+    assert.ok(config.token.length >= 32);
+    assert.equal(await app.invoke("get_mcp_server_status"), true);
+    await app.invoke("add_local_mcp_to_agent", { agentId: "cursor" });
+    const cursor = JSON.parse(
+      await readFile(
+        path.join(app.root, "home", ".cursor", "mcp.json"),
+        "utf8",
+      ),
+    );
+    const entries = Object.values(cursor.mcpServers ?? {});
+    assert.ok(
+      entries.some((entry) => entry.url === `http://127.0.0.1:${port}/mcp`),
+      "agent installer must use the local endpoint, not require cloud",
+    );
+    const denied = await jsonRequest(`http://127.0.0.1:${port}/mcp`, {
+      method: "POST",
+      token: "invalid",
+      body: {},
+    });
+    assert.equal(denied.response.status, 401);
+    const initialized = await jsonRequest(`http://127.0.0.1:${port}/mcp`, {
+      method: "POST",
+      token: config.token,
+      body: {
+        jsonrpc: "2.0",
+        id: 1,
+        method: "initialize",
+        params: {
+          protocolVersion: "2025-03-26",
+          capabilities: {},
+          clientInfo: { name: "native-e2e", version: "1" },
+        },
+      },
+    });
+    assert.equal(initialized.response.status, 200);
+    assert.ok(initialized.value.result);
+    await app.invoke("stop_mcp_server");
+    assert.equal(await app.invoke("get_mcp_server_status"), false);
+    assert.equal(await app.invoke("get_mcp_config"), null);
+  });
+});
